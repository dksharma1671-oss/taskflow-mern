# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (get from MongoDB Atlas dashboard)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/taskflow?retryWrites=true&w=majority

# JWT
JWT_SECRET=this_is_a_super_secret_key_change_it
JWT_EXPIRE=7d

# Frontend URL (for CORS + password reset link)
CLIENT_URL=http://localhost:5173

# Email (only needed if you want real forgot-password emails)
# If you don't set these, reset link will just be printed in the server console (works fine for demo)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=youremail@gmail.com
EMAIL_PASS=your_gmail_app_password
